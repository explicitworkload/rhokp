#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Finish an RHOKP install that was deployed without credentials: pull the image
# with your registry pull secret, store your access key as a podman secret, and
# start the portal.
#
# When Ansible already pulled the image at deploy time there is nothing to
# download and no pull secret is asked for -- only the access key.
#
set -euo pipefail

usage() {
  cat <<USAGE
Usage: {{ rhokp_helper_path }} [options]

  -p, --pull-secret FILE  registry pull secret (prompted for only if the
                          image is not already on this node)
  -k, --access-key FILE   RHOKP access key (prompted for otherwise)
      --no-access-key     deploy without one, no prompt. RHOKP then runs in
                          limited-access mode
  -f, --force-pull        re-pull the image even if it is already here
  -h, --help              this text

  sudo {{ rhokp_helper_path }}                      # prompt for what is needed
  sudo {{ rhokp_helper_path }} -p /tmp/ps.json -k /tmp/key
USAGE
}

IMAGE="{{ rhokp_image }}"
SECRET_NAME="{{ rhokp_access_key_secret_name }}"
UNIT="{{ _rhokp_unit }}"
UNIT_FILE="{{ _rhokp_quadlet_dir }}/{{ rhokp_service_name }}.container"
CONF_DIR="{{ _rhokp_conf_dir }}"
{% if rhokp_rootless | bool %}
SYSTEMCTL=(systemctl --user)
{% else %}
SYSTEMCTL=(systemctl)
{% endif %}

PULL_SECRET_SRC=""
ACCESS_KEY_SRC=""
FORCE_PULL=false
NO_KEY=false

die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
info() { printf '\033[36m==>\033[0m %s\n' "$*"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--pull-secret) PULL_SECRET_SRC="${2:?}"; shift 2 ;;
    -k|--access-key)  ACCESS_KEY_SRC="${2:?}";  shift 2 ;;
    --no-access-key)  NO_KEY=true;              shift ;;
    -f|--force-pull)  FORCE_PULL=true;          shift ;;
    -h|--help)        usage; exit 0 ;;
    *)                die "unknown option: $1" ;;
  esac
done

umask 077
WORKDIR="$(mktemp -d)"
trap 'rm -rf "${WORKDIR}"' EXIT

# --- do we actually need to download anything? -----------------------------
#
# The image is ~7.8 GB. Ansible pre-pulls it at deploy time whenever it was
# given a pull secret, so on most installs it is already here -- in which case
# there is nothing to download and no reason to ask for a pull secret at all.

NEED_PULL=true
if [[ "${FORCE_PULL}" == false ]] && podman image exists "${IMAGE}" 2>/dev/null; then
  NEED_PULL=false
fi

if [[ "${NEED_PULL}" == false && -n "${PULL_SECRET_SRC}" ]]; then
  info "Ignoring the pull secret; pass --force-pull to download again anyway."
  PULL_SECRET_SRC=""
fi

# --- pull secret -----------------------------------------------------------

if [[ "${NEED_PULL}" == false ]]; then
  info "${IMAGE} is already on this node -- skipping the download."
else
  if [[ -z "${PULL_SECRET_SRC}" ]]; then
    echo "Paste your Red Hat pull secret, from"
    echo "  https://console.redhat.com/openshift/install/pull-secret"
    echo "then press Enter."
    echo
    # Stop as soon as what has been pasted parses as JSON, rather than at EOF.
    # The Copy button gives one long line, so Enter finishes it; the Download
    # button gives pretty-printed JSON over many lines, so the closing brace
    # finishes it. Neither needs Ctrl-D, though Ctrl-D still works and is what
    # ends an empty or malformed paste.
    _buf=""
    _line=""
    while IFS= read -r _line || [[ -n "${_line}" ]]; do
      _buf+="${_line}"$'\n'
      if printf '%s' "${_buf}" | python3 -I -c 'import json, sys; json.load(sys.stdin)' 2>/dev/null; then
        break
      fi
    done
    printf '%s' "${_buf}" > "${WORKDIR}/auth.json"
    unset _buf _line
    echo
  else
    [[ -f "${PULL_SECRET_SRC}" ]] || die "no such file: ${PULL_SECRET_SRC}"
    cp "${PULL_SECRET_SRC}" "${WORKDIR}/auth.json"
  fi
  chmod 600 "${WORKDIR}/auth.json"

  # Reports in one line rather than a traceback: whoever hits this is halfway
  # through a lab, not debugging python.
  python3 -I -c '
import json, sys
try:
    auths = json.load(open(sys.argv[1]))["auths"]
except ValueError:
    sys.exit("it is not valid JSON")
except KeyError:
    sys.exit("it is JSON, but has no \"auths\" key")
if "{{ rhokp_registry_host }}" not in auths:
    sys.exit("its \"auths\" has no {{ rhokp_registry_host }} entry")
' "${WORKDIR}/auth.json" || {
    echo >&2
    echo "That is not a usable pull secret -- see the reason above." >&2
    echo >&2
    echo "A very long single-line paste can be truncated by the terminal. Try" >&2
    echo "Download instead of Copy and paste the formatted JSON, or save it to a" >&2
    echo "file:  sudo {{ rhokp_helper_path }} -p /path/to/pull-secret.json" >&2
    exit 1
  }
fi

# --- access key ------------------------------------------------------------

limited_access_notice() {
  cat <<'NOTICE'

  Without an access key RHOKP runs in limited-access mode:

    - a banner across the top of the portal saying access is limited
    - product documentation, product lifecycle pages and the Security Data
      API are all still browsable
    - the encrypted Knowledgebase content and the search index stay locked

  You can add a key later by running this command again.

NOTICE
}

if [[ "${NO_KEY}" == true ]]; then
  limited_access_notice
elif [[ -n "${ACCESS_KEY_SRC}" ]]; then
  # An explicit -k pointing at an empty file is a mistake worth reporting,
  # not an invitation to deploy without a key. --no-access-key is the way to
  # ask for that deliberately.
  [[ -f "${ACCESS_KEY_SRC}" ]] || die "no such file: ${ACCESS_KEY_SRC}"
  tr -d '\r\n' < "${ACCESS_KEY_SRC}" > "${WORKDIR}/key"
  [[ -s "${WORKDIR}/key" ]] || die "${ACCESS_KEY_SRC} is empty."
else
  # Echoed on purpose, not read silently. These are short-lived lab keys and a
  # paste that lost its last characters is otherwise invisible until the
  # container exits with ERR_002. Worth knowing if you are sharing a screen.
  read -rp "RHOKP access key (press Enter to skip): " key
  if [[ -z "${key}" ]]; then
    limited_access_notice
    read -rp "Deploy RHOKP without an access key? [y/N] " reply
    case "${reply}" in
      y|Y|yes|Yes|YES) NO_KEY=true ;;
      *) die "Cancelled -- nothing has changed. Generate a key at
         https://access.redhat.com/offline/access and run this again." ;;
    esac
  else
    printf '%s' "${key}" > "${WORKDIR}/key"
  fi
  unset key
fi

if [[ "${NO_KEY}" == false ]]; then
  [[ -s "${WORKDIR}/key" ]] || die "the access key is empty."
fi

# --- apply -----------------------------------------------------------------

if [[ "${NEED_PULL}" == true ]]; then
  info "Pulling ${IMAGE} -- about 7.8 GB, so this takes a few minutes"
  podman pull --authfile "${WORKDIR}/auth.json" "${IMAGE}"
fi

# The unit may only carry Secret= when the secret exists, so the two are
# changed together. The line sits immediately above PublishPort with no blank
# line, exactly where rhokp.container.j2 renders it, so an Ansible re-run
# finds the file already correct instead of rewriting it and bouncing the
# portal. See the comment in that template before moving either one.
SECRET_LINE="Secret=${SECRET_NAME},type=env,target=ACCESS_KEY"

unit_secret_line() {   # add | remove
  [[ -f "${UNIT_FILE}" ]] || die "no unit file at ${UNIT_FILE} -- is RHOKP installed?"
  case "$1" in
    add)
      grep -qxF "${SECRET_LINE}" "${UNIT_FILE}" && return 0
      grep -q '^PublishPort=' "${UNIT_FILE}" \
        || die "${UNIT_FILE} has no PublishPort= line to anchor against."
      sed -i "0,/^PublishPort=/s//${SECRET_LINE}\n&/" "${UNIT_FILE}"
      ;;
    remove)
      grep -qxF "${SECRET_LINE}" "${UNIT_FILE}" || return 0
      sed -i "\\|^${SECRET_LINE}\$|d" "${UNIT_FILE}"
      ;;
  esac
}

mkdir -p "${CONF_DIR}"
chmod 700 "${CONF_DIR}"

if [[ "${NO_KEY}" == true ]]; then
  info "Deploying without an access key (limited-access mode)"
  podman secret rm "${SECRET_NAME}" >/dev/null 2>&1 || true
  rm -f "${CONF_DIR}/access-key.sha256"
  unit_secret_line remove
else
  info "Storing the access key as podman secret '${SECRET_NAME}'"
  podman secret rm "${SECRET_NAME}" >/dev/null 2>&1 || true
  podman secret create "${SECRET_NAME}" "${WORKDIR}/key" >/dev/null
  unit_secret_line add

  sha256sum < "${WORKDIR}/key" | awk '{print $1}' > "${CONF_DIR}/access-key.sha256"
  chmod 600 "${CONF_DIR}/access-key.sha256"
fi

info "Starting ${UNIT}"
"${SYSTEMCTL[@]}" daemon-reload
"${SYSTEMCTL[@]}" restart "${UNIT}"

echo
echo "Waiting for the portal (a cold start takes about 45s)..."
for i in $(seq 1 30); do
  if curl -fsS -o /dev/null "http://127.0.0.1:{{ rhokp_http_port }}/" 2>/dev/null; then
    echo "Portal is up on port {{ rhokp_http_port }}."
    if [[ "${NO_KEY}" == true ]]; then
      echo "Running in limited-access mode -- expect the banner at the top."
      echo "Run this command again at any time to add an access key."
    fi
    exit 0
  fi
  sleep 5
done

echo "Still not answering. Check:  journalctl {{ '--user ' if rhokp_rootless | bool else '' }}-u ${UNIT} -n 50" >&2
exit 1
