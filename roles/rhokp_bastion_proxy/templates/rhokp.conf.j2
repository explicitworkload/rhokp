{{ ansible_managed | comment }}
# Routes the catalog Routes through to the portal on {{ rhokp_bastion_proxy_target }}.
#
#   http://{{ field_asset.route_app | default('app-<guid>.<subdomain>') }}         -> bastion:8080 -> here
#   https://{{ field_asset.route_app_secure | default('app-secure-<guid>.<subdomain>') }} -> bastion:8443 -> here
#
# TLS is terminated at the edge by the Route, so this proxies plain HTTP.
#
# The platform's /etc/nginx/conf.d/bastion-proxy.conf includes this file and
# then declares its own `location / { try_files ... }`. Declaring a second
# `location /` here is a duplicate and nginx refuses to start:
#
#   nginx: [emerg] duplicate location "/" in .../bastion-proxy.conf
#
{% if rhokp_bastion_proxy_path == '/' %}
# nginx matches regex locations ahead of plain-prefix ones, so `~ ^/` claims
# every request and the platform's catch-all never runs. Note that proxy_pass
# in a regex location must carry no URI part.
location ~ ^/ {
    proxy_pass http://{{ _rhokp_proxy_upstream }};
{% else %}
# Mounted under a sub-path, which does not collide with the platform's
# `location /` at all.
location {{ rhokp_bastion_proxy_path }} {
    proxy_pass http://{{ _rhokp_proxy_upstream }}/;
{% endif %}
    proxy_http_version 1.1;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    proxy_buffering      off;
    proxy_redirect       off;
    proxy_connect_timeout 15s;
    proxy_read_timeout   {{ rhokp_bastion_proxy_read_timeout }}s;
    proxy_send_timeout   {{ rhokp_bastion_proxy_read_timeout }}s;

    client_max_body_size 0;
}
