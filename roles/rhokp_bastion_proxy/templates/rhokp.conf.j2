{{ ansible_managed | comment }}
# Routes the catalog Routes through to the portal on {{ rhokp_bastion_proxy_target }}.
#
#   http://{{ field_asset.route_app | default('app-<guid>.<subdomain>') }}         -> bastion:8080 -> here
#   https://{{ field_asset.route_app_secure | default('app-secure-<guid>.<subdomain>') }} -> bastion:8443 -> here
#
# TLS is terminated at the edge by the Route, so this proxies plain HTTP.

location / {
    proxy_pass http://{{ hostvars[rhokp_bastion_proxy_target]['ansible_host'] | default(rhokp_bastion_proxy_target) }}:{{ rhokp_bastion_proxy_port }}/;
    proxy_http_version 1.1;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    proxy_buffering      off;
    proxy_redirect       off;
    proxy_connect_timeout 15s;
    proxy_read_timeout   {{ rhokp_bastion_proxy_read_timeout }}s;
    proxy_send_timeout   {{ rhokp_bastion_proxy_read_timeout }}s;

    client_max_body_size 0;
}
