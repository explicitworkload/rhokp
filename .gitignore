# --- plaintext credentials: never commit -----------------------------------
pull-secret.json
rhokp-access-key
.env
*.pem
*.key
!*.vault

# --- secret material -------------------------------------------------------
# This is a PUBLIC repository, so nothing credential-shaped is committed --
# not even the AES256 vault files. Deny-by-default; only the docs get through.
playbooks/secrets/*
!playbooks/secrets/.gitkeep
!playbooks/secrets/README.md

# Run scripts/init-secrets.sh to recreate the vault files locally. If you fork
# this into a PRIVATE repo and want a turnkey RHDP deploy, override the rule
# deliberately:
#     git add -f playbooks/secrets/access-key.vault
#     git add -f playbooks/secrets/pull-secret.json.vault
#     git add -f playbooks/secrets/vault-password
# See "RHDP" in README.md before you do.

# Legacy location, kept so an old checkout cannot leak one.
.vault-password
ansible/.vault-password

# --- ansible runtime artefacts ---------------------------------------------
collections/
*.retry
.ansible/

# --- showroom: build output and local preview tooling ----------------------
www/
node_modules/

# --- editors / OS ----------------------------------------------------------
.DS_Store
.idea/
.vscode/
